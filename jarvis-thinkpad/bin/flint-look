#!/usr/bin/env bash
# flint-look: the agent's eyes. Prints the path of a picture (the agent then reads the image), or text.
#
#   flint-look desk [out.jpg]        a webcam frame (from the presence watcher if it is running, else ffmpeg)
#   flint-look screen [out.png]      the whole screen
#   flint-look window "title" [out]  one window, by (part of) its title
#   flint-look text [image]          the text in an image (OCR, tesseract); default: a fresh screenshot
#   flint-look phone                 a photo taken with the phone's camera (KDE Connect)
#
# "What is on my desk?" -> flint-look desk, then read the file. "Read me the error on screen" -> flint-look text.
set -uo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/flint"; mkdir -p "$STATE"
CAM="${FLINT_CAMERA:-/dev/video0}"
if [ -z "${DISPLAY:-}" ] && [ -S /tmp/.X11-unix/X0 ]; then export DISPLAY=:0; export XAUTHORITY="${XAUTHORITY:-$(ls /run/user/$(id -u)/gdm/Xauthority 2>/dev/null | head -1)}"; fi

snap_cam() {  # snap_cam out.jpg
  local live="$STATE/look-live.jpg"
  if [ -f "$live" ] && [ "$(( $(date +%s) - $(stat -c %Y "$live") ))" -le 5 ]; then cp "$live" "$1"; return 0; fi
  [ -e "$CAM" ] || { echo "no camera at $CAM" >&2; return 1; }
  # skip the first frames: webcams need a moment to set exposure
  ffmpeg -y -loglevel error -f v4l2 -video_size 1280x720 -i "$CAM" -vf "select=gte(n\,8)" -frames:v 1 -update 1 "$1" 2>/dev/null \
    || ffmpeg -y -loglevel error -f v4l2 -i "$CAM" -frames:v 1 -update 1 "$1" 2>/dev/null
  [ -s "$1" ] || { echo "the camera did not deliver a frame (busy, or blocked by the privacy shutter?)" >&2; return 1; }
}
shot() {  # shot out.png [window-title]
  if [ -n "${2:-}" ]; then
    local wid; wid="$(xdotool search --name "$2" 2>/dev/null | head -1)"
    [ -n "$wid" ] || { echo "no window with '$2' in its title (wmctrl -l lists them)" >&2; return 1; }
    xdotool windowactivate --sync "$wid" 2>/dev/null; sleep 0.4
    gnome-screenshot -w -f "$1" 2>/dev/null || import -window "$wid" "$1" 2>/dev/null
  else
    gnome-screenshot -f "$1" 2>/dev/null || import -window root "$1" 2>/dev/null
  fi
  [ -s "$1" ] || { echo "no screenshot (no display?)" >&2; return 1; }
}

case "${1:-}" in
  desk)   out="${2:-$STATE/look-desk.jpg}"; snap_cam "$out" && echo "$out" ;;
  screen) out="${2:-$STATE/look-screen.png}"; shot "$out" && echo "$out" ;;
  window) [ -n "${2:-}" ] || { echo "usage: flint-look window \"title\" [out.png]" >&2; exit 1; }; out="${3:-$STATE/look-window.png}"; shot "$out" "$2" && echo "$out" ;;
  text)
    command -v tesseract >/dev/null || { echo "tesseract is not installed (sudo apt-get install -y tesseract-ocr)" >&2; exit 1; }
    img="${2:-}"; if [ -z "$img" ]; then img="$STATE/look-screen.png"; shot "$img" || exit 1; fi
    tesseract "$img" - --psm 3 2>/dev/null | sed '/^[[:space:]]*$/d' ;;
  phone)
    command -v kdeconnect-cli >/dev/null || { echo "KDE Connect is not installed" >&2; exit 1; }
    dev="$(kdeconnect-cli -a --id-only 2>/dev/null | head -1)"; [ -n "$dev" ] || { echo "no phone connected (flint-phone devices)" >&2; exit 1; }
    out="$STATE/look-phone.jpg"; rm -f "$out"
    kdeconnect-cli -d "$dev" --photo "$out" >/dev/null 2>&1
    for _ in $(seq 1 60); do [ -s "$out" ] && { echo "$out"; exit 0; }; sleep 1; done
    echo "the phone did not send a photo within a minute (take it on the phone when it asks)" >&2; exit 1 ;;
  -h|--help|"") sed -n '2,10p' "$0" ;;
  *) echo "unknown: $1 (flint-look --help)" >&2; exit 1 ;;
esac
