#!/usr/bin/env python3
"""flint-mail: your mailbox for the agent, over IMAP and SMTP (works without any connector).

  flint-mail setup                         host, address, app password -> ~/.config/flint/mail.env (chmod 600)
  flint-mail unread [n]                    the newest unread messages: id, from, subject, date, a preview
  flint-mail recent [n]                    the newest messages, read or not
  flint-mail read <id>                     one message as plain text
  flint-mail search "words" [n]            subject, sender or body
  flint-mail draft --to a@b --subject "..." --body "..." [--reply <id>] [--attach file]
  flint-mail send  ... same, plus --confirm   (nothing leaves without --confirm)
  flint-mail mark <id> read|unread

Gmail: IMAP imap.gmail.com, SMTP smtp.gmail.com, an App Password (Google account > Security > 2-step
verification > App passwords). Other providers: their IMAP/SMTP hosts. Ids are IMAP UIDs in the inbox.
The Gmail connector in Claude Code (claude.ai > Settings > Connectors) is the richer path when connected;
this one is local, plain and always there.
"""
import email
import email.header
import email.utils
import imaplib
import mimetypes
import os
import smtplib
import sys
from email.message import EmailMessage
from html.parser import HTMLParser

HOME = os.path.expanduser("~")
ENV = os.path.join(HOME, ".config", "flint", "mail.env")


def read_env():
    d = {}
    try:
        for line in open(ENV):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                d[k.strip()] = v.strip().strip("'\"")
    except OSError:
        pass
    return d


CFG = read_env()
IMAP_HOST = CFG.get("MAIL_IMAP_HOST", "imap.gmail.com")
SMTP_HOST = CFG.get("MAIL_SMTP_HOST", "smtp.gmail.com")
SMTP_PORT = int(CFG.get("MAIL_SMTP_PORT", "465") or 465)
USER = CFG.get("MAIL_USER", "")
PASSWORD = CFG.get("MAIL_PASSWORD", "")
FROM_NAME = CFG.get("MAIL_FROM_NAME", "")


class _Text(HTMLParser):
    def __init__(self):
        super().__init__(); self.out = []; self.skip = 0

    def handle_starttag(self, tag, attrs):
        if tag in ("script", "style"):
            self.skip += 1
        if tag in ("p", "br", "div", "tr", "li", "h1", "h2", "h3"):
            self.out.append("\n")

    def handle_endtag(self, tag):
        if tag in ("script", "style") and self.skip:
            self.skip -= 1

    def handle_data(self, data):
        if not self.skip:
            self.out.append(data)


def html_to_text(html):
    p = _Text(); p.feed(html)
    lines = [" ".join(l.split()) for l in "".join(p.out).splitlines()]
    return "\n".join(l for l in lines if l)


def dec(s):
    if not s:
        return ""
    return "".join(t.decode(enc or "utf-8", "replace") if isinstance(t, bytes) else t for t, enc in email.header.decode_header(s))


def body_text(msg, limit=None):
    parts = []
    for part in msg.walk():
        ct = part.get_content_type()
        if part.get_content_disposition() == "attachment":
            continue
        if ct == "text/plain":
            parts.append(part.get_payload(decode=True).decode(part.get_content_charset() or "utf-8", "replace"))
        elif ct == "text/html" and not parts:
            parts.append(html_to_text(part.get_payload(decode=True).decode(part.get_content_charset() or "utf-8", "replace")))
    text = "\n".join(parts).strip()
    return text[:limit] + ("…" if limit and len(text) > limit else "") if limit else text


def need():
    if not USER or not PASSWORD:
        sys.exit("mail is not set up: flint-mail setup")


def imap():
    need()
    m = imaplib.IMAP4_SSL(IMAP_HOST)
    m.login(USER, PASSWORD)
    m.select("INBOX")
    return m


def listing(m, criteria, n):
    _, data = m.uid("search", None, criteria)
    uids = data[0].split()[-n:][::-1]
    for uid in uids:
        _, d = m.uid("fetch", uid, "(BODY.PEEK[])")
        msg = email.message_from_bytes(d[0][1])
        frm = dec(msg.get("From", "")); subj = dec(msg.get("Subject", "(no subject)"))
        date = email.utils.parsedate_to_datetime(msg.get("Date")).strftime("%Y-%m-%d %H:%M") if msg.get("Date") else ""
        print(f"[{uid.decode()}] {date}  {frm}\n    {subj}\n    {body_text(msg, 160).replace(chr(10), ' ')}")
    if not uids:
        print("nothing")


def cmd_read(uid):
    m = imap()
    _, d = m.uid("fetch", uid.encode(), "(BODY.PEEK[])")
    if not d or d[0] is None:
        sys.exit(f"no message {uid}")
    msg = email.message_from_bytes(d[0][1])
    print(f"From: {dec(msg.get('From'))}\nTo: {dec(msg.get('To'))}\nDate: {msg.get('Date')}\nSubject: {dec(msg.get('Subject'))}")
    atts = [dec(p.get_filename()) for p in msg.walk() if p.get_content_disposition() == "attachment"]
    if atts:
        print("Attachments: " + ", ".join(a for a in atts if a))
    print()
    print(body_text(msg, 20000))
    m.logout()


def compose(args, send):
    need()
    def opt(name, default=None):
        return args[args.index(name) + 1] if name in args else default
    to, subject, body = opt("--to"), opt("--subject", ""), opt("--body", "")
    reply, attach = opt("--reply"), opt("--attach")
    if not to or not body:
        sys.exit("need --to and --body (and --subject)")
    msg = EmailMessage()
    msg["From"] = f"{FROM_NAME} <{USER}>" if FROM_NAME else USER
    msg["To"] = to
    if reply:
        m = imap()
        _, d = m.uid("fetch", reply.encode(), "(BODY.PEEK[HEADER])")
        orig = email.message_from_bytes(d[0][1])
        msg["In-Reply-To"] = orig.get("Message-ID", ""); msg["References"] = orig.get("Message-ID", "")
        if not subject:
            subject = "Re: " + dec(orig.get("Subject", ""))
        m.logout()
    msg["Subject"] = subject
    msg.set_content(body)
    if attach:
        ctype, _ = mimetypes.guess_type(attach)
        main, sub = (ctype or "application/octet-stream").split("/", 1)
        msg.add_attachment(open(attach, "rb").read(), maintype=main, subtype=sub, filename=os.path.basename(attach))
    print(f"To: {to}\nSubject: {subject}\n\n{body}" + (f"\n\n[attachment: {attach}]" if attach else ""))
    if not send:
        print("\n(draft only; add --confirm to send)"); return 0
    if "--confirm" not in args:
        print("\nNOT SENT: --confirm is missing"); return 1
    with smtplib.SMTP_SSL(SMTP_HOST, SMTP_PORT) as s:
        s.login(USER, PASSWORD); s.send_message(msg)
    print("\nsent"); return 0


def setup():
    cfg = read_env()
    if not sys.stdin.isatty():
        sys.exit("run flint-mail setup in a terminal")
    print("Gmail: imap.gmail.com / smtp.gmail.com and an App Password (Google account > Security > App passwords).")
    cfg["MAIL_IMAP_HOST"] = input(f"IMAP host [{cfg.get('MAIL_IMAP_HOST', 'imap.gmail.com')}]: ").strip() or cfg.get("MAIL_IMAP_HOST", "imap.gmail.com")
    cfg["MAIL_SMTP_HOST"] = input(f"SMTP host [{cfg.get('MAIL_SMTP_HOST', 'smtp.gmail.com')}]: ").strip() or cfg.get("MAIL_SMTP_HOST", "smtp.gmail.com")
    cfg["MAIL_SMTP_PORT"] = input(f"SMTP port (SSL) [{cfg.get('MAIL_SMTP_PORT', '465')}]: ").strip() or cfg.get("MAIL_SMTP_PORT", "465")
    cfg["MAIL_USER"] = input(f"address [{cfg.get('MAIL_USER', '')}]: ").strip() or cfg.get("MAIL_USER", "")
    import getpass
    pw = getpass.getpass("app password (hidden; Enter keeps the current one): ")
    if pw:
        cfg["MAIL_PASSWORD"] = pw
    cfg["MAIL_FROM_NAME"] = input(f"your name on outgoing mail [{cfg.get('MAIL_FROM_NAME', '')}]: ").strip() or cfg.get("MAIL_FROM_NAME", "")
    os.makedirs(os.path.dirname(ENV), exist_ok=True)
    with open(ENV, "w") as f:
        for k, v in cfg.items():
            f.write(f"{k}={v}\n")
    os.chmod(ENV, 0o600)
    print(f"saved to {ENV} (chmod 600). Testing the login...")
    global USER, PASSWORD, IMAP_HOST
    USER, PASSWORD, IMAP_HOST = cfg["MAIL_USER"], cfg["MAIL_PASSWORD"], cfg["MAIL_IMAP_HOST"]
    m = imap(); m.logout(); print("IMAP login ok")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return 0
    c = argv[0]
    if c == "setup":
        return setup()
    if c in ("unread", "recent"):
        m = imap(); listing(m, "UNSEEN" if c == "unread" else "ALL", int(argv[1]) if len(argv) > 1 else 10); m.logout(); return 0
    if c == "search":
        if len(argv) < 2:
            sys.exit("usage: flint-mail search \"words\" [n]")
        q = argv[1].replace('"', '')
        m = imap(); listing(m, f'(OR (OR SUBJECT "{q}" FROM "{q}") BODY "{q}")', int(argv[2]) if len(argv) > 2 else 10); m.logout(); return 0
    if c == "read":
        return cmd_read(argv[1]) if len(argv) > 1 else sys.exit("usage: flint-mail read <id>")
    if c == "mark":
        m = imap(); m.uid("store", argv[1].encode(), "+FLAGS" if argv[2] == "read" else "-FLAGS", "(\\Seen)"); m.logout(); print("ok"); return 0
    if c in ("draft", "send"):
        return compose(argv[1:], c == "send")
    sys.exit(f"unknown command: {c}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
