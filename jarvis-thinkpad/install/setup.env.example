# setup.env: your answers for the whole install. Copied to ~/.flint-setup/setup.env on the
# first run of setup.sh; edit that copy. Every value has a default (the decisions in
# README.md). Lines starting with # are comments. No secrets belong here except the optional
# Tailscale auth key below (an ElevenLabs key goes in ~/.config/flint/elevenlabs.env, see
# install/README.md); the file is chmod 600 in your home.

# ---- who and what
YOUR_NAME="Valentin"
AGENT_NAME="Flint"
AGENT_HOME="$HOME/my-agent"           # where the agent lives (Claude Code opens here)
VAULT_DIR="$HOME/Brain"               # the Obsidian vault = the agent's memory
IDENTITY_DOOR="B"                     # B = Jared's shipped personality renamed; C = calmer, no swearing
GIT_NAME="Valentin Todorov"
GIT_EMAIL=""                          # git identity for the vault backups and your repos (e.g. you@example.com)

# ---- the voice
PTT_KEY="home"                        # push-to-talk key (home, end, right_ctrl, f12 ...)
MIC_MODE="ptt"                        # ptt | open (hands-free)
VOICE="bm_lewis"                      # Kokoro voice
STT_MODEL="small.en"                  # faster-whisper model (base.en if the machine is slow)
VOICE_PERMISSIONS="ask"               # ask | bypassPermissions (spoken checks first; flip later by voice)
FACE="core"                           # core (Orbitals, the chosen one) | command | board

# ---- the vault interview, pre-answered (the wizard asks these; edit freely, the agent refines later)
YOUR_WORK="I run a personal business and I am building an AI operating partner on this ThinkPad."
PROJECTS="Personal Business; Home Automation; ThinkPad (this machine, the server the agent runs on)"
KEY_PEOPLE=""                         # "Name (role); Name (role)"
PRIORITIES="Get the agent, the team and the home automation working end to end"
RECURRING="Morning brief; Inbox triage; Weekly finance review; Vault backup"

# ---- the machine
TIMEZONE=""                           # empty = keep what the Ubuntu installer set (e.g. Europe/Sofia)
HOSTNAME_WANTED="thinkpad"            # empty = keep the name the Ubuntu installer set
SUDO_NOPASSWD=1                       # 1 = passwordless sudo for your user (unattended setup + full-power agent). Reversible: sudo rm /etc/sudoers.d/90-flint-*
UFW=1                                 # firewall on, SSH (and 8123 if Home Assistant) allowed
FIRMWARE_UPDATE=1                     # fwupd: Lenovo firmware from LVFS (may need one extra reboot)
TIMESHIFT_SNAPSHOT=1                  # a system snapshot at the end (OS only, not your data)

# ---- remote access
TAILSCALE=1
TS_AUTHKEY=""                         # optional: a Tailscale auth key makes it fully unattended; empty = a login link/QR is shown once

# ---- extras
DOCKER=1
HOME_ASSISTANT=1                      # Home Assistant Container + onboarding + long-lived token + MCP server for the agent
HA_USER=""                            # Home Assistant owner username; empty = your Linux username
CLAUDE_DESKTOP=1                      # Claude Desktop for Linux (beta)
GITHUB_CLI=1                          # gh, and a one-time browser login in stage 07 (lets the agent push the vault backup)
VSCODE=0
AUTOSTART_STACK=1                     # start voice + face + hands in a terminal at every login
REMOTE_CONTROL=1                      # keep `claude remote-control` alive in tmux so your phone can drive the agent
AGENT_TIMERS=1                        # the scheduled agent jobs from team.yaml (morning brief etc.)
VAULT_GIT=1                           # hourly local git commits of the vault (a private GitHub push is a later, explicit step)

# ---- how much to ask
ACCOUNTS_LATER=0                      # 1 = skip the two browser logins (Claude, GitHub) now and do them later with: setup.sh --only 07
WIZARD_MODE="headless"                # headless = Jared's installer runs on its own with these answers; interactive = you watch and answer
